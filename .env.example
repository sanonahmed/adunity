# Bot token from @BotFather — used server-side to verify WebApp initData.
# Never expose this with NEXT_PUBLIC_; it must stay on the server.
TELEGRAM_BOT_TOKEN=

# BotFather bot username (without @). Required for invite links: they open the
# bot's main Mini App as https://t.me/<bot>?startapp=ref_<code>.
# The site's "Open in Telegram" link appears as soon as this is set.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Neon PostgreSQL pooled connection string. Keep server-side; never use NEXT_PUBLIC_.
# Neon Console -> project -> Connect -> select pooled connection string.
DATABASE_URL=

# SHA-256 digest of the Auto Bot activation key. Keep server-side; never use NEXT_PUBLIC_.
# Generate a key and its digest with: node -e "const c=require('node:crypto');const k=c.randomBytes(32).toString('base64url');console.log(k);console.log(c.createHash('sha256').update(k).digest('hex'))"
AUTOBOT_ACTIVATION_KEY_SHA256=

# Optional: source SQLite file for the one-time import script only.
SQLITE_FILE=.data/adunity.sqlite
