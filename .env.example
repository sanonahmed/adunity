# Bot token from @BotFather — used server-side to verify WebApp initData.
# Never expose this with NEXT_PUBLIC_; it must stay on the server.
TELEGRAM_BOT_TOKEN=

# BotFather Mini App link settings. Leave blank until the bot and Mini App exist.
# The site shows an "Open in Telegram" link only when both values are configured.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_APP_SHORT_NAME=

# Filled in when the Neon + Drizzle layer lands.
DATABASE_URL=
