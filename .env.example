# Bot token from @BotFather — used server-side to verify WebApp initData.
# Never expose this with NEXT_PUBLIC_; it must stay on the server.
TELEGRAM_BOT_TOKEN=

# BotFather bot username (without @). Required for invite links: they open the
# bot's main Mini App as https://t.me/<bot>?startapp=ref_<code>.
# The site's "Open in Telegram" link appears as soon as this is set.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Neon PostgreSQL pooled connection string. Keep server-side; never use NEXT_PUBLIC_.
# Neon Console -> project -> Connect -> select pooled connection string.
DATABASE_URL=

# Optional: SHA-256 digest of a fallback Auto Bot activation key. Keys are normally
# generated in /admin and stored in Postgres, so they work immediately and can be
# revoked without a restart. Use this only for an env-only deployment.
# Keep server-side; never use NEXT_PUBLIC_.
# Generate a key and its digest with: node -e "const c=require('node:crypto');const k=c.randomBytes(32).toString('base64url');console.log(k);console.log(c.createHash('sha256').update(k).digest('hex'))"
AUTOBOT_ACTIVATION_KEY_SHA256=

# Admin panel (/admin). Both are server-only secrets; never use NEXT_PUBLIC_.
# ADMIN_PASSWORD must be at least 12 characters, ADMIN_SESSION_SECRET at least 32.
# Generate both with: node -e "const c=require('node:crypto');console.log(c.randomBytes(18).toString('base64url'));console.log(c.randomBytes(48).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: set to "false" to skip seeding the six fictional starter listings
# the first time the market tables are created.
MARKET_SEED_DEMO=true

# Optional: source SQLite file for the one-time import script only.
SQLITE_FILE=.data/adunity.sqlite

# Binance Pay merchant API credentials. Server-only; never use NEXT_PUBLIC_.
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_MERCHANT_ID=

# Public HTTPS origin for payment return/cancel URLs and the webhook endpoint.
# Configure the same webhook URL in Binance Merchant Center if needed.
BINANCE_PAY_CALLBACK_BASE_URL=

# Optional: APP, WEB, WAP, MINI_PROGRAM, or OTHERS (defaults to APP).
BINANCE_PAY_TERMINAL_TYPE=APP

# Optional: defaults to https://bpay.binanceapi.com.
BINANCE_PAY_BASE_URL=
