# Bot token from @BotFather — used server-side to verify WebApp initData.
# Never expose this with NEXT_PUBLIC_; it must stay on the server.
TELEGRAM_BOT_TOKEN=

# BotFather Mini App link settings. The bot username is required for invite
# links; the short name is optional and only selects a named Mini App.
# The site shows an "Open in Telegram" link only when the username is set.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_APP_SHORT_NAME=

# SQLite referral store (requires Node >=22.13; default: .data/adunity.sqlite).
# Point this at a persistent writable volume in production. Ephemeral serverless
# filesystems lose referral records on redeploy/restart.
ADUNITY_DB_PATH=
